<Project>
  <!--
    HLSL のコンピュートシェーダーをビルド時に fxc で DXBC にコンパイルし、埋め込みリソース「Shaders/<名前>.cso」として exe に埋め込む。
    fxc は Windows SDK に含まれる。見つからないときは FxcPath で場所を指定する。
  -->
  <PropertyGroup>
    <WindowsKitsRoot Condition="'$(WindowsKitsRoot)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', null, RegistryView.Registry32, RegistryView.Default))</WindowsKitsRoot>
    <!-- IntermediateOutputPath はこの評価の時点ではまだ決まっていない（SDK の targets で決まる）ので、先に決まる BaseIntermediateOutputPath（obj\）を使う -->
    <ShaderOutputDir>$(BaseIntermediateOutputPath)shaders\</ShaderOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <HlslShader Include="Shaders\*.hlsl" />
  </ItemGroup>

  <Target Name="FindFxc" Condition="'$(FxcPath)' == ''">
    <ItemGroup>
      <_FxcCandidate Include="$(WindowsKitsRoot)bin\10.*\x64\fxc.exe" />
    </ItemGroup>
    <PropertyGroup>
      <!-- バージョンのフォルダ名の順に並ぶので、最後のものが最新 -->
      <FxcPath>%(_FxcCandidate.FullPath)</FxcPath>
    </PropertyGroup>
    <Error Condition="'$(FxcPath)' == '' Or !Exists('$(FxcPath)')" Text="fxc.exe が見つかりません。Windows SDK をインストールするか、FxcPath で fxc.exe の場所を指定してください。" />
  </Target>

  <Target Name="CompileShaders"
          BeforeTargets="BeforeBuild;AssignTargetPaths"
          DependsOnTargets="FindFxc"
          Inputs="@(HlslShader);$(MSBuildThisFileFullPath)"
          Outputs="$(ShaderOutputDir)shaders.stamp">
    <!--
      ReUseLinearConvCS は ReUseLinearCS を #include するので、どれかが変われば全部再コンパイルする。
      Outputs をシェーダーごとの .cso にすると、MSBuild は Inputs との対応を見て、変更された入力の分だけを再コンパイルしてしまう。
      そこで出力は 1 つのスタンプファイルにして、どれかの入力がスタンプファイルより新しければ全部をコンパイルする
    -->
    <MakeDir Directories="$(ShaderOutputDir)" />
    <Exec Command="&quot;$(FxcPath)&quot; /nologo /T cs_5_0 /E main /Fo &quot;$(ShaderOutputDir)%(HlslShader.Filename).cso&quot; &quot;%(HlslShader.FullPath)&quot;" />
    <Touch Files="$(ShaderOutputDir)shaders.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="EmbedShaders" BeforeTargets="AssignTargetPaths" AfterTargets="CompileShaders">
    <ItemGroup>
      <EmbeddedResource Include="@(HlslShader->'$(ShaderOutputDir)%(Filename).cso')" LogicalName="Shaders/%(Filename).cso" />
    </ItemGroup>
  </Target>

  <!-- 出力先が IntermediateOutputPath の外なので、FileWrites に追加しても Clean では削除されない。リビルドで再コンパイルするよう、自前で削除する -->
  <Target Name="CleanShaders" AfterTargets="Clean">
    <RemoveDir Directories="$(ShaderOutputDir)" />
  </Target>
</Project>
